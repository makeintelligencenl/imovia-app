NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Tempo de inatividade antes do logout automático (em minutos)
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=15

# Cloudflare Turnstile (login e formulário público de demonstração)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Meta Embedded Signup (conexão do WhatsApp em Configurações > WhatsApp)
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id
