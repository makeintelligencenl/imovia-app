# URL da API do ImovIA (sem barra no final)
IMOVIA_API_URL=https://corretorapi-production.up.railway.app/api/v1

# Chave secreta compartilhada com a API (mesma BOT_API_KEY configurada no Railway)
BOT_API_KEY=troque-por-uma-chave-segura

# ID do tenant (imobiliária) que este agente representa
# Obtido em: GET /api/v1/tenants ou no painel do banco de dados
IMOVIA_TENANT_ID=cuid-da-imobiliaria

# Porta do servidor MCP (padrão: 3002)
PORT=3002
