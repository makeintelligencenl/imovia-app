# Chave secreta compartilhada com a API (mesma BOT_API_KEY configurada no Railway - serviço API)
BOT_API_KEY=troque-pela-chave-configurada-na-api

# ID do tenant BH Premium Imóveis
IMOVIA_TENANT_ID=cmpncy6pq0006mawowq2ar76g

# Chave de acesso ao MCP (opcional — protege os endpoints /sse e /mcp)
