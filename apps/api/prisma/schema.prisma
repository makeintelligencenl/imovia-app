generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Multi-tenancy: cada imobiliária é um tenant
// ─────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  imoveis   Imovel[]
  perfis    PerfilBusca[]
  matches   Match[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// Usuários (corretores e admins da imobiliária)
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CORRETOR)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("users")
}

enum Role {
  ADMIN
  CORRETOR
}

// ─────────────────────────────────────────
// Localidades (fonte: IBGE)
// ─────────────────────────────────────────
model Estado {
  id        Int      @id                // código IBGE
  sigla     String   @unique @db.Char(2)
  nome      String
  cidades   Cidade[]

  @@map("estados")
}

model Cidade {
  id        Int     @id                 // código IBGE
  nome      String
  estadoId  Int
  estado    Estado  @relation(fields: [estadoId], references: [id])

  @@index([estadoId])
  @@map("cidades")
}

// ─────────────────────────────────────────
// Tipos de imóvel (tabela no banco — extensível sem deploy)
// ─────────────────────────────────────────
model TipoImovel {
  id        String   @id @default(cuid())
  nome      String   @unique // "Apartamento", "Casa", "Comercial", "Terreno", "Rural"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  imoveis Imovel[]
  perfis  PerfilBusca[] @relation("PerfilTipos")

  @@map("tipos_imovel")
}

// ─────────────────────────────────────────
// Imóveis cadastrados na plataforma
// ─────────────────────────────────────────
model Imovel {
  id         String       @id @default(cuid())
  titulo     String
  tipoId     String
  tipo       TipoImovel   @relation(fields: [tipoId], references: [id])
  finalidade Finalidade
  preco      Decimal      @db.Decimal(12, 2)
  areaM2     Decimal      @db.Decimal(8, 2)
  quartos    Int?
  banheiros  Int?
  vagas      Int?
  bairro     String
  cidade     String
  estado     String       @db.Char(2)
  latitude   Decimal?     @db.Decimal(10, 7)
  longitude  Decimal?     @db.Decimal(10, 7)
  descricao      String?      @db.Text
  cep            String?      @db.VarChar(9)   // formato 00000-000
  codigoOrigem   String?      @db.VarChar(255) // código no sistema de origem da imobiliária
  urlImovel      String?      @db.VarChar(500) // URL do imóvel no site da imobiliária
  status         StatusImovel @default(DISPONIVEL)
  origem         String?      // 'manual' | 'api' | 'mcp'
  externalId     String?      // ID no sistema de origem (para integrações via API/MCP)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  matches  Match[]

  @@index([tenantId, status])
  @@index([tenantId, finalidade, tipoId])
  @@index([tenantId, cidade])
  @@map("imoveis")
}

enum Finalidade {
  ALUGUEL
  VENDA
}

enum StatusImovel {
  DISPONIVEL
  RESERVADO
  ALUGADO
  VENDIDO
  INATIVO
}

// ─────────────────────────────────────────
// Perfis de busca dos clientes (a "demanda")
// ─────────────────────────────────────────
model PerfilBusca {
  id              String     @id @default(cuid())
  clienteNome     String
  clienteEmail    String
  clienteWhatsapp String?
  finalidade      Finalidade
  precoMin        Decimal    @db.Decimal(12, 2)
  precoMax        Decimal    @db.Decimal(12, 2)
  areaMin         Decimal    @db.Decimal(8, 2)
  areaMax         Decimal?   @db.Decimal(8, 2)
  quartosMin      Int?
  cidades         String[]
  bairros         String[]
  ativo           Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  matches  Match[]
  tipos    TipoImovel[] @relation("PerfilTipos")

  @@index([tenantId, ativo, finalidade])
  @@map("perfis_busca")
}

// ─────────────────────────────────────────
// Registro de matches gerados
// ─────────────────────────────────────────
model Match {
  id        String      @id @default(cuid())
  status    StatusMatch @default(NOTIFICADO)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  perfilId String
  perfil   PerfilBusca @relation(fields: [perfilId], references: [id])

  imovelId String
  imovel   Imovel @relation(fields: [imovelId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([perfilId, imovelId])
  @@index([tenantId])
  @@map("matches")
}

enum StatusMatch {
  NOTIFICADO    // Cliente foi notificado
  VISUALIZADO   // Cliente abriu/viu o imóvel
  INTERESSADO   // Cliente sinalizou interesse
  EM_NEGOCIACAO // Corretor em contato
  FECHADO       // Negócio fechado
  DESCARTADO    // Cliente não quis
}
