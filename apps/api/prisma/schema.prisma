generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Multi-tenancy: cada imobiliária é um tenant
// ─────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  imoveis        Imovel[]
  perfis         PerfilBusca[]
  matches        Match[]
  pipelineEtapas PipelineEtapa[]
  visitas        Visita[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// Usuários (corretores e admins da imobiliária)
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CORRETOR)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  matchesAssociados Match[]          @relation("MatchCorretor")
  historico         MatchHistorico[]
  visitas           Visita[]         @relation("VisitaCorretor")

  @@map("users")
}

enum Role {
  ADMIN
  CORRETOR
}

// ─────────────────────────────────────────
// Localidades (fonte: IBGE)
// ─────────────────────────────────────────
model Estado {
  id        Int      @id                // código IBGE
  sigla     String   @unique @db.Char(2)
  nome      String
  cidades   Cidade[]

  @@map("estados")
}

model Cidade {
  id        Int      @id                // código IBGE
  nome      String
  estadoId  Int
  estado    Estado   @relation(fields: [estadoId], references: [id])
  imoveis   Imovel[]

  @@index([estadoId])
  @@map("cidades")
}

// ─────────────────────────────────────────
// Tipos de imóvel (tabela no banco — extensível sem deploy)
// ─────────────────────────────────────────
model TipoImovel {
  id        String   @id @default(cuid())
  nome      String   @unique // "Apartamento", "Casa", "Comercial", "Terreno", "Rural"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  imoveis Imovel[]
  perfis  PerfilBusca[] @relation("PerfilTipos")

  @@map("tipos_imovel")
}

// ─────────────────────────────────────────
// Imóveis cadastrados na plataforma
// ─────────────────────────────────────────
model Imovel {
  id         String       @id @default(cuid())
  titulo     String
  tipoId     String
  tipo       TipoImovel   @relation(fields: [tipoId], references: [id])
  finalidade Finalidade
  preco      Decimal      @db.Decimal(12, 2)
  areaM2     Decimal      @db.Decimal(8, 2)
  quartos    Int?
  banheiros  Int?
  vagas      Int?
  bairro     String
  cidadeId   Int
  cidade     Cidade       @relation(fields: [cidadeId], references: [id])
  estado     String       @db.Char(2)
  latitude   Decimal?     @db.Decimal(10, 7)
  longitude  Decimal?     @db.Decimal(10, 7)
  descricao      String?      @db.Text
  cep            String?      @db.VarChar(9)   // formato 00000-000
  codigoOrigem   String?      @db.VarChar(255) // código no sistema de origem da imobiliária
  urlImovel      String?      @db.VarChar(500) // URL do imóvel no site da imobiliária
  status         StatusImovel @default(DISPONIVEL)
  origem         String?      // 'manual' | 'api' | 'mcp'
  externalId     String?      // ID no sistema de origem (para integrações via API/MCP)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  matches  Match[]
  visitas  Visita[]

  @@index([tenantId, status])
  @@index([tenantId, finalidade, tipoId])
  @@index([tenantId, cidadeId])
  @@map("imoveis")
}

enum Finalidade {
  ALUGUEL
  VENDA
}

enum StatusImovel {
  DISPONIVEL
  RESERVADO
  ALUGADO
  VENDIDO
  INATIVO
}

// ─────────────────────────────────────────
// Perfis de busca dos clientes (a "demanda")
// ─────────────────────────────────────────
model PerfilBusca {
  id              String     @id @default(cuid())
  clienteNome     String
  clienteEmail    String
  clienteWhatsapp String?
  finalidade      Finalidade
  precoMin        Decimal    @db.Decimal(12, 2)
  precoMax        Decimal    @db.Decimal(12, 2)
  areaMin         Decimal    @db.Decimal(8, 2)
  areaMax         Decimal?   @db.Decimal(8, 2)
  quartosMin      Int?
  cidades         String[]
  bairros         String[]
  ativo           Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  matches  Match[]
  tipos    TipoImovel[] @relation("PerfilTipos")

  @@index([tenantId, ativo, finalidade])
  @@map("perfis_busca")
}

// ─────────────────────────────────────────
// Etapas do pipeline (customizáveis por tenant)
// ─────────────────────────────────────────
model PipelineEtapa {
  id        String   @id @default(cuid())
  nome      String                         // ex: "Novo", "Contatado", "Visita Agendada"
  cor       String   @db.VarChar(7)        // hex ex: "#3B82F6"
  ordem     Int                            // posição na coluna do Kanban
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  matches  Match[]
  historicoOrigem  MatchHistorico[] @relation("HistoricoOrigem")
  historicoDestino MatchHistorico[] @relation("HistoricoDestino")

  @@unique([tenantId, nome])
  @@index([tenantId, ordem])
  @@map("pipeline_etapas")
}

// ─────────────────────────────────────────
// Registro de matches gerados
// ─────────────────────────────────────────
model Match {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perfilId String
  perfil   PerfilBusca @relation(fields: [perfilId], references: [id])

  imovelId String
  imovel   Imovel @relation(fields: [imovelId], references: [id])

  etapaId String
  etapa   PipelineEtapa @relation(fields: [etapaId], references: [id])

  corretorId String?
  corretor   User?   @relation("MatchCorretor", fields: [corretorId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  historico MatchHistorico[]
  visitas   Visita[]

  @@unique([perfilId, imovelId])
  @@index([tenantId])
  @@index([tenantId, etapaId])
  @@index([tenantId, corretorId])
  @@map("matches")
}

// ─────────────────────────────────────────
// Histórico de movimentação do pipeline
// ─────────────────────────────────────────
enum MatchHistoricoTipo {
  MATCH_CRIADO
  ETAPA_ALTERADA
  CORRETOR_ATRIBUIDO
  CORRETOR_REMOVIDO
}

model MatchHistorico {
  id              String             @id @default(cuid())
  matchId         String
  tenantId        String
  tipo            MatchHistoricoTipo
  etapaOrigemId   String?
  etapaDestinoId  String?
  userId          String?            // corretor atribuído/removido  OU  quem moveu a etapa
  createdAt       DateTime           @default(now())

  match        Match          @relation(fields: [matchId],        references: [id], onDelete: Cascade)
  etapaOrigem  PipelineEtapa? @relation("HistoricoOrigem",  fields: [etapaOrigemId],  references: [id], onDelete: SetNull)
  etapaDestino PipelineEtapa? @relation("HistoricoDestino", fields: [etapaDestinoId], references: [id], onDelete: SetNull)
  usuario      User?          @relation(fields: [userId],         references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([tenantId])
  @@map("match_historico")
}

// ─────────────────────────────────────────
// Agendamento de visitas
// ─────────────────────────────────────────
enum VisitaStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
}

model Visita {
  id              String       @id @default(cuid())
  tenantId        String
  matchId         String?
  imovelId        String
  corretorId      String?
  clienteNome     String
  clienteEmail    String?
  clienteWhatsapp String?
  dataHora        DateTime
  duracaoMin      Int          @default(60)
  status          VisitaStatus @default(AGENDADA)
  observacoes     String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant   Tenant        @relation(fields: [tenantId],   references: [id])
  imovel   Imovel        @relation(fields: [imovelId],   references: [id])
  corretor User?         @relation("VisitaCorretor", fields: [corretorId], references: [id], onDelete: SetNull)
  match    Match?        @relation(fields: [matchId],    references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, corretorId])
  @@index([tenantId, dataHora])
  @@map("visitas")
}
