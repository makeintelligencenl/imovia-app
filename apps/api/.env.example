# Runtime da API: usuário imovia_user (só DML, sem DDL).
# Ver apps/api/prisma/manual/01-endurecer-usuario-runtime.sql
DATABASE_URL="postgresql://imovia_user:<senha>@localhost:5432/corretor_imoveis?schema=public"

# Usado SOMENTE por prisma migrate, manualmente, na sua máquina.
# Nunca configure esta variável no serviço da API em deploy.
# MIGRATION_DATABASE_URL="postgresql://postgres:<senha>@localhost:5432/corretor_imoveis?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@seudominio.com.br"
DEMO_NOTIFICATION_EMAIL="contato@seudominio.com.br"

# Cloudflare Turnstile (login e formulário público de demonstração)
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"

NODE_ENV="development"
PORT=3001
